# Gems this plugin needs that are not in Redmine core's bundle.
# Redmine loads this file automatically (plugins/*/{Gemfile,PluginGemfile}).
#
# base64: no longer a Ruby default gem on Ruby 4.0 (Redmine 7 / Rails 8), and
# Redmine 7's Gemfile does not declare it. This plugin uses Base64.* for MIME
# building (Graph client, agent replies, initial mail), so declare it explicitly.
# Harmless on Redmine 5/6 (Ruby 3.x), where base64 still resolves.
gem 'base64'

# pdf-reader: optional text extraction from PDF attachments for the AI summary
# (HelpdeskAiSummaryJob). The call is LoadError-guarded - if the gem is missing
# in the image, PDF text is skipped and the rest of the feature stays usable.
gem 'pdf-reader'

# Knowledge base (RAG): the default backend is Qdrant (pure HTTP, no gem).
# The pg gem is only needed for the optional pgvector backend (kb_backend=pgvector).
# It is deliberately NOT activated here, so the default build does not break
# without libpq-dev; PgvectorStore loads pg via a LoadError-guarded require.
# To activate, add it to the deployment Gemfile (and libpq-dev to the image):
#   gem 'pg'
